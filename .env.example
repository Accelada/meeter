# Ejecuta neon env pull; nunca pegues estas variables en el código del navegador.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
NEON_BRANCH=production

# Despliegue: configura estas variables en el servidor, nunca en el manifiesto.
