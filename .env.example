# Ejecuta neon env pull; nunca pegues estas variables en el código del navegador.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
NEON_BRANCH=production

# Despliegue: configura estas variables en el servidor, nunca en el manifiesto.
# NODE_ENV=production
# PUBLIC_BASE_URL=https://coste.example.com
# SERVICE_API_KEY=GENERAR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
# TLS_TERMINATION=proxy
# HOST=0.0.0.0
# PORT=3000

# Multiempresa: aplicar 003_companies.sql antes de activar.
# MEETER_MULTI_TENANT=true
# NEON_AUTH_BASE_URL=URL_DE_NEON_AUTH_DE_LA_RAMA_DE_PRODUCCION
# MICROSOFT_LOGIN_ENABLED=false
